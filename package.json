{
  "name": "handhold",
  "version": "0.1.0",
  "description": "Make any character hold any prop: automatic hand rigging, grips that physically hold, and poses, animations and looks for Unity, Godot and Blender. Runs in the browser.",
  "license": "MIT",
  "homepage": "https://ozbrett.github.io/handhold/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ozbrett/handhold.git"
  },
  "bugs": "https://github.com/Ozbrett/handhold/issues",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.170.0",
    "@webxr-input-profiles/assets": "^1.0.19",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
